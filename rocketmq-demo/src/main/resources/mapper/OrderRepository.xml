<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rocketmq.mapper.OrderMapper">

    <resultMap id="BaseResultMap" type="com.example.rocketmq.domain.entity.Order">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="order_id" property="orderId" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>
        <result column="amount" property="amount" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="VARCHAR"/>
        <result column="content" property="content" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.rocketmq.domain.entity.Order"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `order` (
            order_id, status, amount, user_id, content, create_time, update_time
        ) VALUES (
                     #{orderId}, #{status}, #{amount}, #{userId}, #{content},
                     #{createTime}, #{updateTime}
                 )
    </insert>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT id, order_id, status, amount, user_id, content, create_time, update_time
        FROM `order`
        WHERE order_id = #{orderId}
            LIMIT 1
    </select>

    <update id="updateStatus" parameterType="com.example.rocketmq.domain.entity.Order">
        UPDATE `order`
        SET status = #{status}, update_time = #{updateTime}
        WHERE order_id = #{orderId}
    </update>

    <delete id="deleteByOrderId">
        DELETE FROM `order` WHERE order_id = #{orderId}
    </delete>

</mapper>